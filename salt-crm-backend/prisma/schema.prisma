model DistributionRule {
  id                  String           @id @default(uuid())
  tenantId            String           @map("tenant_id")
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  type                DistributionType @default(round_robin)
  priority            Int              @default(0)
  isActive            Boolean          @default(true) @map("is_active")
  
  criteria            Json             @default("{}")
  
  targetUsers         String[]         @default([]) @map("target_users")
  targetTeams         String[]         @default([]) @map("target_teams")
  
  respectCapacity     Boolean          @default(true) @map("respect_capacity")
  respectWorkingHours Boolean          @default(true) @map("respect_working_hours")
  
  lastAssignedUserId  String?          @map("last_assigned_user_id")
  lastAssignedUser    User?            @relation(fields: [lastAssignedUserId], references: [id])
  lastAssignedAt      DateTime?        @map("last_assigned_at")
  
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  // Relations
  distributionLogs DistributionLog[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("distribution_rules")
}

model DistributionLog {
  id               String              @id @default(uuid())
  tenantId         String              @map("tenant_id")
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId           String              @map("lead_id")
  lead             Lead                @relation(fields: [leadId], references: [id])
  ruleId           String?             @map("rule_id")
  rule             DistributionRule?   @relation(fields: [ruleId], references: [id])
  assignedToId     String              @map("assigned_to")
  assignedTo       User                @relation("DistributionAssigned", fields: [assignedToId], references: [id])
  
  distributionType DistributionLogType @default(automatic) @map("distribution_type")
  previousOwnerId  String?             @map("previous_owner")
  previousOwner    User?               @relation("DistributionPrevious", fields: [previousOwnerId], references: [id])
  reason           String?
  
  createdAt        DateTime            @default(now()) @map("created_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([leadId])
  @@map("distribution_logs")
}

