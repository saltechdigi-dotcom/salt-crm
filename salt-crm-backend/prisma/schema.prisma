// ============================================================
// SALT CRM - PRISMA SCHEMA
// Versão: 2.0
// Data: Fevereiro 2026
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum TenantStatus {
  active
  suspended
  cancelled
}

enum TenantLifecycleStatus {
  onboarding
  active
  risk
  overdue
  suspended
  cancelled
}

enum PaymentStatus {
  on_time
  overdue
}

enum BillingPeriodicity {
  monthly
  annual
}

enum UserRole {
  admin
  manager
  agent
}

enum SuperAdminRole {
  master
  operational
}

enum LeadTemperature {
  cold
  warm
  hot
}

enum LeadOriginType {
  paid
  organic
  referral
  manual
  api
}

enum FunnelType {
  sales
  prospecting
  portfolio
}

enum ExitType {
  won
  lost
  archived
  out_of_profile
  no_response
}

enum ConversationStatus {
  ai_handling
  manual
  waiting
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageSenderType {
  client
  agent
  ai
  system
}

enum MessageContentType {
  text
  image
  audio
  video
  document
  location
  contact
  sticker
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

enum WhatsappType {
  business
  api
}

enum WhatsappStatus {
  connected
  disconnected
  pending
  banned
}

enum ScheduleType {
  meeting
  visit
  call
  return_call @map("return")
  other
}

enum ScheduleStatus {
  confirmed
  tentative
  cancelled
  completed
}

enum DocumentType {
  cpf
  cnpj
}

enum PaymentMethod {
  pix
  credit_card
  debit_card
  boleto
  transfer
  cash
}

enum PaymentCondition {
  cash
  installment
}

enum SaleStatus {
  pending_manager
  pending_admin
  validated
  rejected
}

enum NpsChannel {
  whatsapp
  email
  sms
}

enum NpsClassification {
  promoter
  passive
  detractor
}

enum DistributionType {
  round_robin
  weighted
  priority
  manual
}

enum DistributionLogType {
  automatic
  manual
  transfer
}

enum AiPromptType {
  sdr
  followup
  nps
  qualification
  objection
}

enum AiInteractionType {
  qualification
  response
  followup
  nps
}

enum AutomationTriggerType {
  webhook
  schedule
  manual
  event
}

enum AutomationStatus {
  started
  success
  failed
  timeout
}

enum SlaMetricType {
  first_response
  stage_time
  followup
  resolution
}

enum LeadHistoryEventType {
  observation
  schedule_created
  schedule_completed
  schedule_cancelled
  status_change
  temperature_change
  transfer
  sale_registered
  contact_attempt
  message_sent
  message_received
  ai_interaction
  assignment
}

enum NotificationType {
  info
  success
  warning
  error
}

enum NotificationCategory {
  message
  team_message
  operational
  institutional
  sale
}

enum SupportType {
  whatsapp
  funnel
  ai
  billing
  technical
  other
}

enum SupportPriority {
  low
  medium
  high
  critical
}

enum SupportStatus {
  open
  in_progress
  resolved
}

enum AlertType {
  error
  warning
  connection
}

enum AlertStatus {
  pending
  resolved
}

enum TagEntityType {
  lead
  conversation
  sale
}

// ============================================================
// CORE - MULTI-TENANCY
// ============================================================

model Plan {
  id                    String   @id @default(uuid())
  name                  String   @unique
  displayName           String   @map("display_name")
  description           String?
  pricePerUserMonthly   Decimal  @map("price_per_user_monthly") @db.Decimal(10, 2)
  pricePerUserAnnual    Decimal  @map("price_per_user_annual") @db.Decimal(10, 2)
  baseUsers             Int      @default(3) @map("base_users")
  maxUsers              Int?     @map("max_users")
  features              Json     @default("{}")
  isActive              Boolean  @default(true) @map("is_active")
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenants Tenant[]

  @@map("plans")
}

model Tenant {
  id                String                  @id @default(uuid())
  name              String
  slug              String?                 @unique
  document          String?
  email             String
  phone             String?
  logoUrl           String?                 @map("logo_url")
  primaryColor      String?                 @default("#007AFF") @map("primary_color")
  
  planId            String?                 @map("plan_id")
  plan              Plan?                   @relation(fields: [planId], references: [id])
  billingPeriodicity BillingPeriodicity    @default(monthly) @map("billing_periodicity")
  monthlyValue      Decimal                 @default(0) @map("monthly_value") @db.Decimal(12, 2)
  usersLimit        Int                     @default(3) @map("users_limit")
  
  status            TenantStatus            @default(active)
  lifecycleStatus   TenantLifecycleStatus   @default(onboarding) @map("lifecycle_status")
  paymentStatus     PaymentStatus           @default(on_time) @map("payment_status")
  
  lastPaymentAt     DateTime?               @map("last_payment_at")
  nextDueDate       DateTime?               @map("next_due_date") @db.Date
  suspendedAt       DateTime?               @map("suspended_at")
  cancelledAt       DateTime?               @map("cancelled_at")
  
  segment           String?
  salesOrigin       String?                 @map("sales_origin")
  internalNotes     String?                 @map("internal_notes")
  
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  // Relations
  featureOverrides    TenantFeatureOverride[]
  teams               Team[]
  users               User[]
  leadOrigins         LeadOrigin[]
  funnels             Funnel[]
  funnelStages        FunnelStage[]
  lossReasons         LossReason[]
  leads               Lead[]
  leadStageHistory    LeadStageHistory[]
  leadHistory         LeadHistory[]
  tags                Tag[]
  whatsappConnections WhatsappConnection[]
  conversations       Conversation[]
  messages            Message[]
  products            Product[]
  sales               Sale[]
  schedules           Schedule[]
  npsSurveys          NpsSurvey[]
  distributionRules   DistributionRule[]
  distributionLogs    DistributionLog[]
  aiPrompts           AiPrompt[]
  aiInteractionLogs   AiInteractionLog[]
  automationLogs      AutomationLog[]
  slaMetrics          SlaMetric[]
  dashboardMetrics    DashboardMetricDaily[]
  aiAgents            AiAgent[]
  settings            TenantSettings?
  onboarding          TenantOnboarding?
  notifications       Notification[]
  supportTickets      SupportTicket[]
  criticalAlerts      CriticalAlert[]

  @@index([status])
  @@index([lifecycleStatus])
  @@index([planId])
  @@map("tenants")
}

model SuperAdminUser {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  name          String
  avatarUrl     String?         @map("avatar_url")
  role          SuperAdminRole  @default(operational)
  isActive      Boolean         @default(true) @map("is_active")
  refreshToken  String?         @map("refresh_token")
  lastLoginAt   DateTime?       @map("last_login_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  // Relations
  featureOverrides  TenantFeatureOverride[] @relation("EnabledBy")
  ticketsAssigned   SupportTicket[]         @relation("AssignedTo")
  ticketsResolved   SupportTicket[]         @relation("ResolvedBy")
  alertsResolved    CriticalAlert[]

  @@map("super_admin_users")
}

model TenantFeatureOverride {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureKey  String          @map("feature_key")
  enabled     Boolean
  enabledById String?         @map("enabled_by")
  enabledBy   SuperAdminUser? @relation("EnabledBy", fields: [enabledById], references: [id])
  enabledAt   DateTime        @default(now()) @map("enabled_at")
  expiresAt   DateTime?       @map("expires_at")
  notes       String?

  @@unique([tenantId, featureKey])
  @@index([tenantId])
  @@map("tenant_feature_overrides")
}

model Team {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  managerId   String?  @map("manager_id")
  manager     User?    @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  members             User[]                 @relation("TeamMembers")
  leads               Lead[]
  dashboardMetrics    DashboardMetricDaily[]
  notifications       Notification[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("teams")
}

model User {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email             String
  password          String
  name              String
  phone             String?
  avatarUrl         String?   @map("avatar_url")
  
  role              UserRole  @default(agent)
  teamId            String?   @map("team_id")
  team              Team?     @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  managerId         String?   @map("manager_id")
  manager           User?     @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  
  weight            Int       @default(1)
  receivesLeads     Boolean   @default(true) @map("receives_leads")
  maxLeadsPerDay    Int?      @map("max_leads_per_day")
  
  workingHoursStart String?   @default("08:00") @map("working_hours_start")
  workingHoursEnd   String?   @default("18:00") @map("working_hours_end")
  workingDays       Int[]     @default([1, 2, 3, 4, 5]) @map("working_days")
  timezone          String?   @default("America/Sao_Paulo")
  
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  refreshToken      String?   @map("refresh_token")
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  managedTeams          Team[]                 @relation("TeamManager")
  subordinates          User[]                 @relation("UserManager")
  assignedLeads         Lead[]                 @relation("AssignedTo")
  leadsStageChangedBy   LeadStageHistory[]
  leadHistoryCreatedBy  LeadHistory[]
  conversationsAssigned Conversation[]         @relation("ConversationAssigned")
  conversationsPinned   Conversation[]         @relation("ConversationPinned")
  messagesSent          Message[]
  salesAsAgent          Sale[]                 @relation("SaleAgent")
  salesAsManager        Sale[]                 @relation("SaleManager")
  schedules             Schedule[]
  npsSurveys            NpsSurvey[]
  distributionAssigned  DistributionLog[]      @relation("DistributionAssigned")
  distributionPrevious  DistributionLog[]      @relation("DistributionPrevious")
  lastAssignedRules     DistributionRule[]
  slaMetrics            SlaMetric[]
  dashboardMetrics      DashboardMetricDaily[]
  notifications         Notification[]
  supportTickets        SupportTicket[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([teamId])
  @@index([managerId])
  @@index([tenantId, role])
  @@index([tenantId, isActive])
  @@map("users")
}

// ============================================================
// LEADS E FUNIL
// ============================================================

model LeadOrigin {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  type        LeadOriginType @default(manual)
  color       String?        @default("#6B7280")
  icon        String?
  webhookKey  String?        @unique @map("webhook_key")
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  leads            Lead[]
  dashboardMetrics DashboardMetricDaily[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("lead_origins")
}

model Funnel {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  type        FunnelType @default(sales)
  description String?
  isDefault   Boolean    @default(false) @map("is_default")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  stages           FunnelStage[]
  leads            Lead[]
  dashboardMetrics DashboardMetricDaily[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("funnels")
}

model FunnelStage {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  funnelId          String    @map("funnel_id")
  funnel            Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  name              String
  color             String    @default("#6B7280")
  orderIndex        Int       @map("order_index")
  
  isEntry           Boolean   @default(false) @map("is_entry")
  isExit            Boolean   @default(false) @map("is_exit")
  exitType          ExitType? @map("exit_type")
  
  slaHours          Int?      @map("sla_hours")
  autoFollowupHours Int?      @map("auto_followup_hours")
  
  description       String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  leads              Lead[]
  stageHistoryFrom   LeadStageHistory[] @relation("FromStage")
  stageHistoryTo     LeadStageHistory[] @relation("ToStage")

  @@unique([funnelId, orderIndex])
  @@index([funnelId])
  @@index([tenantId])
  @@map("funnel_stages")
}

model LossReason {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  leads Lead[]

  @@unique([tenantId, name])
  @@map("loss_reasons")
}

model Lead {
  id                    String          @id @default(uuid())
  tenantId              String          @map("tenant_id")
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Dados pessoais
  name                  String
  phone                 String
  email                 String?
  document              String?
  documentType          DocumentType?   @map("document_type")
  avatarUrl             String?         @map("avatar_url")
  
  // Endereço
  city                  String?
  state                 String?
  country               String?         @default("BR")
  addressStreet         String?         @map("address_street")
  addressNumber         String?         @map("address_number")
  addressComplement     String?         @map("address_complement")
  addressNeighborhood   String?         @map("address_neighborhood")
  addressZipcode        String?         @map("address_zipcode")
  
  // Origem
  originId              String?         @map("origin_id")
  origin                LeadOrigin?     @relation(fields: [originId], references: [id])
  reference             String?
  utmSource             String?         @map("utm_source")
  utmMedium             String?         @map("utm_medium")
  utmCampaign           String?         @map("utm_campaign")
  utmContent            String?         @map("utm_content")
  utmTerm               String?         @map("utm_term")
  
  // Funil
  funnelId              String          @map("funnel_id")
  funnel                Funnel          @relation(fields: [funnelId], references: [id])
  stageId               String          @map("stage_id")
  stage                 FunnelStage     @relation(fields: [stageId], references: [id])
  temperature           LeadTemperature @default(cold)
  
  // Atribuição
  assignedToId          String?         @map("assigned_to")
  assignedTo            User?           @relation("AssignedTo", fields: [assignedToId], references: [id])
  teamId                String?         @map("team_id")
  team                  Team?           @relation(fields: [teamId], references: [id])
  
  // Qualificação IA
  qualifiedByAi         Boolean         @default(false) @map("qualified_by_ai")
  aiQualificationScore  Decimal?        @map("ai_qualification_score") @db.Decimal(3, 2)
  aiQualificationReason String?         @map("ai_qualification_reason")
  
  // Métricas
  firstResponseAt       DateTime?       @map("first_response_at")
  responseTimeSeconds   Int?            @map("response_time_seconds")
  lastInteractionAt     DateTime?       @map("last_interaction_at")
  interactionCount      Int             @default(0) @map("interaction_count")
  
  // Conversão
  convertedToClientAt   DateTime?       @map("converted_to_client_at")
  lossReasonId          String?         @map("loss_reason_id")
  lossReason            LossReason?     @relation(fields: [lossReasonId], references: [id])
  lossNotes             String?         @map("loss_notes")
  
  // Extras
  customFields          Json?           @default("{}") @map("custom_fields")
  
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  // Relations
  stageHistory      LeadStageHistory[]
  history           LeadHistory[]
  tags              LeadTag[]
  conversations     Conversation[]
  sales             Sale[]
  schedules         Schedule[]
  npsSurveys        NpsSurvey[]
  distributionLogs  DistributionLog[]
  aiInteractionLogs AiInteractionLog[]
  slaMetrics        SlaMetric[]

  @@index([tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([assignedToId])
  @@index([teamId])
  @@index([stageId])
  @@index([funnelId])
  @@index([originId])
  @@index([tenantId, temperature])
  @@index([tenantId, qualifiedByAi])
  @@map("leads")
}

model LeadStageHistory {
  id                        String       @id @default(uuid())
  tenantId                  String       @map("tenant_id")
  tenant                    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId                    String       @map("lead_id")
  lead                      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStageId               String?      @map("from_stage_id")
  fromStage                 FunnelStage? @relation("FromStage", fields: [fromStageId], references: [id])
  toStageId                 String       @map("to_stage_id")
  toStage                   FunnelStage  @relation("ToStage", fields: [toStageId], references: [id])
  changedById               String?      @map("changed_by")
  changedBy                 User?        @relation(fields: [changedById], references: [id])
  timeInPreviousStageSeconds Int?        @map("time_in_previous_stage_seconds")
  notes                     String?
  createdAt                 DateTime     @default(now()) @map("created_at")

  @@index([leadId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("lead_stage_history")
}

model LeadHistory {
  id          String               @id @default(uuid())
  tenantId    String               @map("tenant_id")
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      String               @map("lead_id")
  lead        Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  eventType   LeadHistoryEventType @map("event_type")
  title       String
  description String?
  metadata    Json?                @default("{}")
  createdById String?              @map("created_by")
  createdBy   User?                @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([leadId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([leadId, eventType])
  @@map("lead_history")
}

model Tag {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  color      String        @default("#6B7280")
  entityType TagEntityType @default(lead) @map("entity_type")
  createdAt  DateTime      @default(now()) @map("created_at")

  // Relations
  leadTags LeadTag[]

  @@unique([tenantId, name, entityType])
  @@index([tenantId])
  @@map("tags")
}

model LeadTag {
  leadId    String   @map("lead_id")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tagId     String   @map("tag_id")
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([leadId, tagId])
  @@index([tagId])
  @@map("lead_tags")
}

// ============================================================
// COMUNICAÇÃO - WHATSAPP
// ============================================================

model WhatsappConnection {
  id                 String         @id @default(uuid())
  tenantId           String         @map("tenant_id")
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instanceId         String         @unique @map("instance_id")
  instanceToken      String?        @map("instance_token")
  phoneNumber        String         @map("phone_number")
  name               String?
  type               WhatsappType   @default(business)
  status             WhatsappStatus @default(pending)
  qrCode             String?        @map("qr_code")
  webhookUrl         String?        @map("webhook_url")
  lastConnectedAt    DateTime?      @map("last_connected_at")
  lastDisconnectedAt DateTime?      @map("last_disconnected_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  // Relations
  conversations Conversation[]

  @@index([tenantId])
  @@index([status])
  @@map("whatsapp_connections")
}

model Conversation {
  id                    String             @id @default(uuid())
  tenantId              String             @map("tenant_id")
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId                String?            @map("lead_id")
  lead                  Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  whatsappConnectionId  String?            @map("whatsapp_connection_id")
  whatsappConnection    WhatsappConnection? @relation(fields: [whatsappConnectionId], references: [id])
  
  contactPhone          String             @map("contact_phone")
  contactLid            String?            @map("contact_lid")
  contactName           String?            @map("contact_name")
  
  status                ConversationStatus @default(ai_handling)
  assignedToId          String?            @map("assigned_to")
  assignedTo            User?              @relation("ConversationAssigned", fields: [assignedToId], references: [id])
  
  unreadCount           Int                @default(0) @map("unread_count")
  lastMessageAt         DateTime?          @map("last_message_at")
  lastMessagePreview    String?            @map("last_message_preview")
  
  isPinned              Boolean            @default(false) @map("is_pinned")
  pinReason             String?            @map("pin_reason")
  pinExpiresAt          DateTime?          @map("pin_expires_at")
  pinnedById            String?            @map("pinned_by")
  pinnedBy              User?              @relation("ConversationPinned", fields: [pinnedById], references: [id])
  pinnedAt              DateTime?          @map("pinned_at")
  
  aiContext             Json?              @default("{}") @map("ai_context")
  
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  // Relations
  messages          Message[]
  npsSurveys        NpsSurvey[]
  aiInteractionLogs AiInteractionLog[]
  slaMetrics        SlaMetric[]

  @@index([tenantId])
  @@index([leadId])
  @@index([assignedToId])
  @@index([tenantId, contactPhone])
  @@index([tenantId, status])
  @@index([tenantId, unreadCount])
  @@index([tenantId, isPinned])
  @@map("conversations")
}

model Message {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String             @map("conversation_id")
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId     String?            @map("external_id")
  
  direction      MessageDirection
  senderType     MessageSenderType  @map("sender_type")
  senderId       String?            @map("sender_id")
  sender         User?              @relation(fields: [senderId], references: [id])
  senderName     String?            @map("sender_name")
  
  contentType    MessageContentType @default(text) @map("content_type")
  content        String?
  mediaUrl       String?            @map("media_url")
  mediaMimeType  String?            @map("media_mime_type")
  
