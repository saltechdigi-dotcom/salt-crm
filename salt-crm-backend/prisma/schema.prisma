  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Horário
  workingHoursStart       String?  @default("08:00") @map("working_hours_start")
  workingHoursEnd         String?  @default("18:00") @map("working_hours_end")
  workingDays             Int[]    @default([1, 2, 3, 4, 5]) @map("working_days")
  timezone                String?  @default("America/Sao_Paulo")
  
  // Automação
  autoAssignLeads         Boolean  @default(true) @map("auto_assign_leads")
  
  // IA
  aiEnabled               Boolean  @default(true) @map("ai_enabled")
  aiAutoQualify           Boolean  @default(true) @map("ai_auto_qualify")
  aiAutoRespond           Boolean  @default(true) @map("ai_auto_respond")
  
  // SLA
  slaFirstResponseMinutes Int?     @default(60) @map("sla_first_response_minutes")
