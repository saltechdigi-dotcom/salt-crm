  originId               String?     @map("origin_id")
  origin                 LeadOrigin? @relation(fields: [originId], references: [id])
  funnelId               String?     @map("funnel_id")
  funnel                 Funnel?     @relation(fields: [funnelId], references: [id])
  
  // Leads
  leadsReceived          Int         @default(0) @map("leads_received")
  leadsQualified         Int         @default(0) @map("leads_qualified")
  leadsWon               Int         @default(0) @map("leads_won")
  leadsLost              Int         @default(0) @map("leads_lost")
  
  // Comunicação
  conversationsStarted   Int         @default(0) @map("conversations_started")
