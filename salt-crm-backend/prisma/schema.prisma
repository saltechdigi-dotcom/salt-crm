// ============================================================
// VENDAS E PÓS-VENDA
// ============================================================

model Product {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String?
  name        String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  category    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  sales Sale[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("products")
}

model Sale {
  id                  String           @id @default(uuid())
  tenantId            String           @map("tenant_id")
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId              String?          @map("lead_id")
  lead                Lead?            @relation(fields: [leadId], references: [id])
  
  // Responsáveis
  agentId             String           @map("agent_id")
  agent               User             @relation("SaleAgent", fields: [agentId], references: [id])
  managerId           String?          @map("manager_id")
  manager             User?            @relation("SaleManager", fields: [managerId], references: [id])
  
  // Dados do cliente
  clientName          String           @map("client_name")
  clientDocument      String?          @map("client_document")
  clientDocumentType  DocumentType?    @map("client_document_type")
  clientPhone         String?          @map("client_phone")
  clientEmail         String?          @map("client_email")
  clientAddress       Json?            @map("client_address")
  
  // Produto
  productId           String?          @map("product_id")
  product             Product?         @relation(fields: [productId], references: [id])
  productName         String           @map("product_name")
  productCode         String?          @map("product_code")
  
  // Valores
  saleValue           Decimal          @map("sale_value") @db.Decimal(12, 2)
  discountValue       Decimal?         @default(0) @map("discount_value") @db.Decimal(12, 2)
  finalValue          Decimal          @map("final_value") @db.Decimal(12, 2)
  
  // Pagamento
  paymentMethod       PaymentMethod    @map("payment_method")
  paymentCondition    PaymentCondition @default(cash) @map("payment_condition")
  installments        Int?             @default(1)
  saleDate            DateTime         @default(now()) @map("sale_date") @db.Date
  
  // Validação
  status              SaleStatus       @default(pending_manager)
  managerValidatedAt  DateTime?        @map("manager_validated_at")
  managerRejectedAt   DateTime?        @map("manager_rejected_at")
  managerComment      String?          @map("manager_comment")
  adminViewedAt       DateTime?        @map("admin_viewed_at")
  
  // Extras
  observations        String?
  
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  // Relations
  npsSurveys NpsSurvey[]

  @@index([tenantId])
  @@index([tenantId, saleDate(sort: Desc)])
  @@index([agentId])
  @@index([managerId])
  @@index([tenantId, status])
  @@index([leadId])
  @@map("sales")
}

model Schedule {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId          String?        @map("lead_id")
  lead            Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId    String         @map("assigned_to")
  assignedTo      User           @relation(fields: [assignedToId], references: [id])
  
  type            ScheduleType   @default(meeting)
  title           String
  description     String?
  
  scheduledAt     DateTime       @map("scheduled_at")
  endAt           DateTime?      @map("end_at")
  timezone        String?        @default("America/Sao_Paulo")
  
  location        String?
  conferenceLink  String?        @map("conference_link")
  
  status          ScheduleStatus @default(confirmed)
  reminderMinutes Int[]          @default([30, 60]) @map("reminder_minutes")
  
  googleCalendarId String?       @map("google_calendar_id")
  syncStatus       String?       @default("pending") @map("sync_status")
  
  completedAt     DateTime?      @map("completed_at")
  completionNotes String?        @map("completion_notes")
  
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([assignedToId])
  @@index([leadId])
  @@index([tenantId, scheduledAt])
